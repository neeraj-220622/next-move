# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME=NextMove
APP_ENV=development
LOG_LEVEL=INFO

# ─── Backend server ───────────────────────────────────────────────────────────
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# ─── Frontend (CORS allowlist) ────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:5173

# ─── Hindsight memory server ──────────────────────────────────────────────────
# Local Hindsight instance — server must be started separately.
HINDSIGHT_BASE_URL=http://localhost:8888
HINDSIGHT_TIMEOUT=10

# ─── Local LLM (Qwen or compatible) ──────────────────────────────────────────
# Provider options: local | openai-compatible | disabled
LLM_PROVIDER=local
# Model identifier understood by the local inference runtime
LLM_MODEL=
# Base URL for the local OpenAI-compatible endpoint (e.g. Ollama, LM Studio)
LLM_BASE_URL=http://localhost:11434/v1
LLM_TIMEOUT=30

# ─── Forecasting ──────────────────────────────────────────────────────────────
# Options: baseline | sklearn | xgboost
FORECASTING_MODEL=baseline
